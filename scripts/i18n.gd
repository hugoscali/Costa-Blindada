## Traduce `k` según el idioma activo. Si la clave falta en el idioma elegido
## cae al español; si tampoco está, devuelve la propia clave (igual que antes).
static func t(lang: int, k: String) -> String:
	var tbl: Dictionary = TR_EN if lang == 1 else TR_ES
	if tbl.has(k):
		return tbl[k]
	return TR_ES.get(k, k)
